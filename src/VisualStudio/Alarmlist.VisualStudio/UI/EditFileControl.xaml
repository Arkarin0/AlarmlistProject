                      <Button Command="{Binding ClearCommand}" Click="OnCollectionAction" AutomationProperties.Name="{Binding Name, StringFormat=Clear {0} entries}"><StackPanel Orientation="Horizontal"><ContentControl Content="{ui:MenuIcon {x:Static catalog:KnownMonikers.ClearWindowContent}}" /><TextBlock Text="Clear previous entries" Margin="4,0,0,0" /></StackPanel></Button>
                      <Button Command="{Binding CollapseEntriesCommand}" Tag="PreserveDraft" AutomationProperties.Name="{Binding Name, StringFormat=Collapse {0} entries}"><StackPanel Orientation="Horizontal"><ContentControl Content="{ui:MenuIcon {x:Static catalog:KnownMonikers.CollapseAll}}" /><TextBlock Text="Collapse entries" Margin="4,0,0,0" /></StackPanel></Button>
                      <Button Command="{Binding ExpandEntriesCommand}" Tag="PreserveDraft" AutomationProperties.Name="{Binding Name, StringFormat=Expand {0} entries}"><StackPanel Orientation="Horizontal"><ContentControl Content="{ui:MenuIcon {x:Static catalog:KnownMonikers.ExpandAll}}" /><TextBlock Text="Expand entries" Margin="4,0,0,0" /></StackPanel></Button>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Expander Style="{StaticResource CollectionEntry}" IsExpanded="{Binding IsExpanded}" AutomationProperties.Name="{Binding Label}">
