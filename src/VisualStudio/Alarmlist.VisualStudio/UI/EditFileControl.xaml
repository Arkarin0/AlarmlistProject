              <DataTemplate>
                <Expander Header="{Binding Label}" Style="{StaticResource CollectionGroup}" IsExpanded="{Binding IsExpanded}" ui:StickyCollectionHeader.Detail="{Binding Status}"
                          AutomationProperties.Name="{Binding Name, StringFormat=Collection {0}}">
                  <Expander.Resources><Style TargetType="ToggleButton"><Setter Property="Tag" Value="PreserveDraft" /></Style></Expander.Resources>
                  <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Text="{Binding Help}" TextWrapping="Wrap" />
