                                          AutomationProperties.Name="ReferenceName" AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" MinHeight="27" IsUndoEnabled="False" LostKeyboardFocus="OnFieldLostFocus"
                                          ToolTip="Type an identifier or alarm name to search. Arrows choose and Enter applies. Escape closes suggestions first; Enter then commits a literal value. Clear the text to remove the reference."
