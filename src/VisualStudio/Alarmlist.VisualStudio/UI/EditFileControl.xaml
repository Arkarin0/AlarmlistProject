                              <Button Content="Down" Command="{Binding DownCommand}" Click="OnCollectionAction" AutomationProperties.Name="Move collection entry down" />
                              <Button Content="Delete" Command="{Binding DeleteCommand}" Click="OnCollectionAction" AutomationProperties.Name="Delete collection entry" />
                              </StackPanel>
                              <StackPanel><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding State}" /><TextBlock Text="{Binding Error}" TextWrapping="Wrap" /></StackPanel>
                            </DockPanel>
                          </Expander.Header>
                          <StackPanel>
                          <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding CanEdit}" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate><DataTemplate>
                              <Grid Margin="0,2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CollectionLabels" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="CollectionFieldLabel" Text="{Binding Label}" Margin="0,3,8,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                  <DataTrigger Binding="{Binding DataContext.IsSimple, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <ui:ExpressionTextBox Grid.Column="1" RawText="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
