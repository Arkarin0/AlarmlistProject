<UserControl x:Class="Alarmlist.VisualStudio.EditFileControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:Alarmlist.VisualStudio.UI"
  xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
  Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
  Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
  SizeChanged="OnSizeChanged" PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visibility" />
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxTextBrushKey}}" />
      <Setter Property="Padding" Value="5,3" />
    </Style>
    <Style TargetType="ui:ExpressionTextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
    <Style TargetType="Button"><Setter Property="Padding" Value="9,3" /><Setter Property="Margin" Value="0,0,6,0" /></Style>
    <DataTemplate x:Key="ProcedureAnalysisRow">
      <AdornerDecorator Margin="0,0,0,8">
        <ContentControl ui:InheritedValueBehavior.IsInherited="{Binding IsInherited}" Focusable="False"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding OriginText}"
                        ToolTip="{Binding OriginText}">
          <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}" Padding="26,6,6,6">
            <StackPanel>
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                       VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Label, StringFormat=Procedure {0}}"
                       AutomationProperties.HelpText="{Binding OriginText}" />
              <TextBlock Text="{Binding OriginText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ExclusionText}" TextWrapping="Wrap" />
              <Button Content="Go to source" Command="{Binding GoToSourceCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                      AutomationProperties.Name="{Binding Label, StringFormat=Go to source for {0}}" />
            </StackPanel>
          </Border>
        </ContentControl>
      </AdornerDecorator>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <ui:ParameterListControl DataContext="{Binding FileParameters}" LostKeyboardFocus="OnFieldLostFocus" Margin="0,0,0,12" />
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="_Add alarm" Command="{Binding AddCommand}" />
        <Button Content="_Delete" Command="{Binding DeleteCommand}" />
      </StackPanel>
      <TextBlock Text="Filter alarms" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter alarms" ToolTip="Filter alarms by name or identifier" Margin="0,0,10,0" />
    </DockPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <ComboBox ItemsSource="{Binding Projects}" SelectedValuePath="ProjectPath" SelectedValue="{Binding SelectedProjectPath}"
                AutomationProperties.Name="Analysis project context" Margin="0,0,0,4">
        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem">
          <Setter Property="AutomationProperties.Name"><Setter.Value>
            <MultiBinding StringFormat="{}{0} ({1})"><Binding Path="ProjectPath" /><Binding Path="Configuration" /></MultiBinding>
          </Setter.Value></Setter>
        </Style></ComboBox.ItemContainerStyle>
        <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Text>
          <MultiBinding StringFormat="{}{0} ({1})"><Binding Path="ProjectPath" /><Binding Path="Configuration" /></MultiBinding>
        </TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <ui:LiveStatusTextBlock Text="{Binding CultureGuidance}" TextWrapping="Wrap" />
      <ui:LiveStatusTextBlock Text="{Binding AnalysisMessage}" TextWrapping="Wrap" />
      <ui:LiveStatusTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
      <Expander Header="{Binding DiagnosticsHeading}" Margin="0,4,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
          <StackPanel>
            <TextBlock Text="{Binding DiagnosticsGuidance}" TextWrapping="Wrap" Margin="0,4,0,6" />
            <ItemsControl ItemsSource="{Binding Diagnostics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Locations}">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Command="{Binding NavigateCommand}" HorizontalAlignment="Left" Margin="0,3,0,0" AutomationProperties.Name="{Binding Label}">
                          <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        </Button>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Expander>
    </StackPanel>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ListBox x:Name="AlarmList" ItemsSource="{Binding Alarms}" SelectedItem="{Binding Selected}" Background="Transparent" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,12,0" AutomationProperties.Name="Alarms">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Title}" /></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Identity}" FontSize="11" Opacity="0.75" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <DockPanel Grid.Column="1">
        <ComboBox x:Name="AlarmSelector" DockPanel.Dock="Top" ItemsSource="{Binding Alarms}" SelectedItem="{Binding Selected}" DisplayMemberPath="Title" Visibility="Collapsed" Margin="0,0,0,8" AutomationProperties.Name="Selected alarm">
          <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Title}" /></Style></ComboBox.ItemContainerStyle>
        </ComboBox>
        <TextBlock DockPanel.Dock="Bottom" Text="Checkboxes describe local XML elements. Empty scalar values can still inherit. Use Override locally to start an editable copy; Escape cancels it." TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
          <Expander Header="Resolved alarm preview" Margin="0,0,8,10">
            <StackPanel Margin="0,6,0,0">
              <TextBlock Text="{Binding PreviewContext}" TextWrapping="Wrap" />
              <ui:LiveStatusTextBlock Text="{Binding ResolvedPreviewMessage}" TextWrapping="Wrap" Margin="0,4,0,8" />
              <ItemsControl ItemsSource="{Binding ResolvedFields}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <AdornerDecorator>
                      <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" Padding="26,3,5,3"
                               ui:InheritedValueBehavior.IsInherited="{Binding IsInherited}" TextWrapping="Wrap"
                               MaxHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Name, StringFormat=Resolved {0}}"
                               AutomationProperties.HelpText="{Binding OriginText}" ToolTip="{Binding OriginText}" />
                    </AdornerDecorator>
                    <TextBlock Text="{Binding OriginText}" TextWrapping="Wrap" />
                    <Button Content="Go to source" Command="{Binding GoToSourceCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            AutomationProperties.Name="{Binding Name, StringFormat=Go to source for resolved {0}}" />
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding ResolvedSections}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Margin="0,3,0,6" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ProcedureAnalysisRow}" />
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
          <Expander Header="Compiled project XML preview" Margin="0,0,8,12">
            <StackPanel Margin="0,6,0,0">
              <TextBlock Text="{Binding PreviewContext}" TextWrapping="Wrap" />
              <ui:LiveStatusTextBlock Text="{Binding XmlPreviewMessage}" TextWrapping="Wrap" Margin="0,4,0,6" />
              <TextBox Text="{Binding CompiledXml, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                       MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Compiled project XML" AutomationProperties.HelpText="{Binding XmlPreviewMessage}" />
            </StackPanel>
          </Expander>
          <ui:ParameterListControl DataContext="{Binding AlarmParameters}" LostKeyboardFocus="OnFieldLostFocus" Margin="0,0,8,12" />
          <StackPanel IsEnabled="{Binding CanEdit}">
          <CheckBox Content="Abstract template (excluded from output)" IsChecked="{Binding IsAbstract}" Margin="0,0,8,12" AutomationProperties.Name="Abstract template" />
          <StackPanel Margin="0,0,8,12">
            <TextBlock Text="Reference selection" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding ReferenceChoices}" SelectedItem="{Binding SelectedReferenceChoice}" DisplayMemberPath="Label"
                      IsTextSearchEnabled="True" TextSearch.TextPath="Identifier" AutomationProperties.Name="Reference candidates" Margin="0,0,0,5" />
            <WrapPanel>
              <Button Content="Use selected reference" Command="{Binding ApplyReferenceCommand}" />
              <Button Content="Go to reference" Command="{Binding GoToReferenceCommand}" />
            </WrapPanel>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding CanEdit}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,8,10">
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsPresent}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,0,4" Click="OnPresenceChanged" ToolTip="Include a local value for this field" />
                  <ui:ExpressionTextBox x:Name="LocalValueEditor" RawText="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ResolvedText="{Binding ResolvedValue}" HasResolvedValue="{Binding CanShowResolved}" IsExpressionEnabled="{Binding IsScalar}" Suggestions="{Binding DataContext.CompletionProperties, RelativeSource={RelativeSource AncestorType=UserControl}}" ValidateSuggestions="{Binding DataContext.ValidateCompletion, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding IsPresent}" Visibility="{Binding ShowLocalEditor, Converter={StaticResource Visibility}}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding ValueStatus}" ToolTip="{Binding ValueStatus}" LostKeyboardFocus="OnFieldLostFocus" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="27" MaxHeight="110" VerticalScrollBarVisibility="Auto" IsUndoEnabled="False" />
                  <AdornerDecorator Visibility="{Binding IsInherited, Converter={StaticResource Visibility}}">
                    <TextBox Text="{Binding EffectiveValue, Mode=OneWay}" IsReadOnly="True" Padding="26,3,5,3"
                             ui:InheritedValueBehavior.IsInherited="{Binding IsInherited}" AutomationProperties.Name="{Binding Name}"
                             AutomationProperties.HelpText="{Binding OriginText}" ToolTip="{Binding OriginText}"
                             TextWrapping="Wrap" MinHeight="27" MaxHeight="110" VerticalScrollBarVisibility="Auto" />
                  </AdornerDecorator>
                  <TextBlock Text="{Binding OriginText}" Visibility="{Binding IsInherited, Converter={StaticResource Visibility}}" TextWrapping="Wrap" Margin="0,3,0,3" />
                  <WrapPanel Visibility="{Binding IsScalar, Converter={StaticResource Visibility}}" Margin="0,4,0,0">
                    <Button Content="Override locally" Command="{Binding OverrideCommand}" Visibility="{Binding IsInherited, Converter={StaticResource Visibility}}"
                            Tag="{Binding ElementName=LocalValueEditor}" Click="OnOverrideLocally"
                            AutomationProperties.Name="{Binding Name, StringFormat=Override {0} locally}" />
                    <Button Content="Go to source" Command="{Binding GoToSourceCommand}" Visibility="{Binding IsInherited, Converter={StaticResource Visibility}}"
                            AutomationProperties.Name="{Binding Name, StringFormat=Go to source for {0}}" />
                    <Button Content="Use inherited value" Command="{Binding UseInheritedCommand}" Visibility="{Binding IsPresent, Converter={StaticResource Visibility}}"
                            AutomationProperties.Name="{Binding Name, StringFormat=Use inherited {0}}" />
                  </WrapPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander Header="Test procedure" IsExpanded="True" Margin="0,6,8,0"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="Local entries run in order after inherited entries. Clear resets the preceding entries in its section."
                         TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding ProcedureSections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,16">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,6" />
                      <ui:LiveStatusTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding AnalysisGuidance}" TextWrapping="Wrap" Margin="0,0,0,5" />
                      <TextBlock Text="Make local copy captures the effective sequence now. Future changes to the referenced section will no longer flow here. Undo restores inheritance. Commit or cancel drafts before copying."
                                 TextWrapping="Wrap" Margin="0,0,0,6" />
                      <WrapPanel Margin="0,0,0,8">
                        <Button Content="Use local entries only" Command="{Binding UseLocalEntriesCommand}"
                                AutomationProperties.Name="{Binding Name, StringFormat=Use local {0} entries only}" />
                        <Button Content="Make local copy" Command="{Binding MakeLocalCopyCommand}"
                                AutomationProperties.Name="{Binding Name, StringFormat=Make local copy of {0}}" />
                      </WrapPanel>
                      <ItemsControl ItemsSource="{Binding InheritedItems}" ItemTemplate="{StaticResource ProcedureAnalysisRow}" />
                      <Expander Header="Excluded by Clear" Visibility="{Binding HasExcluded, Converter={StaticResource Visibility}}" Margin="0,0,0,8">
                        <StackPanel>
                          <TextBlock Text="These entries remain in their source XML. Local entries can still be edited in the local source list below." TextWrapping="Wrap" Margin="0,4,0,6" />
                          <ItemsControl ItemsSource="{Binding ExcludedItems}" ItemTemplate="{StaticResource ProcedureAnalysisRow}" />
                        </StackPanel>
                      </Expander>
                      <TextBlock Text="Local source entries (source order)" FontWeight="SemiBold" Margin="0,0,0,6" />
                      <WrapPanel Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewKind}" MinWidth="92" Margin="0,0,6,0"
                                  AutomationProperties.Name="{Binding Name, StringFormat=New {0} entry kind}" />
                        <Button Content="Add entry" Command="{Binding AddCommand}"
                                AutomationProperties.Name="{Binding Name, StringFormat=Add {0} entry}" />
                      </WrapPanel>
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}"
                                    Padding="6" Margin="0,0,0,8">
                              <StackPanel>
                                <WrapPanel Margin="0,0,0,5">
                                  <TextBlock Text="{Binding Number, StringFormat=Source {0}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                  <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding CanEdit}" MinWidth="88" Margin="0,0,6,0"
                                            AutomationProperties.Name="Procedure entry kind" LostKeyboardFocus="OnFieldLostFocus" />
                                  <Button Content="↑" Command="{Binding MoveUpCommand}" ToolTip="Move entry up" AutomationProperties.Name="Move procedure entry up" />
                                  <Button Content="↓" Command="{Binding MoveDownCommand}" ToolTip="Move entry down" AutomationProperties.Name="Move procedure entry down" />
                                  <Button Content="Remove" Command="{Binding DeleteCommand}" AutomationProperties.Name="Remove procedure entry" />
                                </WrapPanel>
                                <Separator Visibility="{Binding IsClear, Converter={StaticResource Visibility}}" />
                                <TextBlock Text="Clear preceding entries" FontWeight="SemiBold" Visibility="{Binding IsClear, Converter={StaticResource Visibility}}" />
                                <ui:ExpressionTextBox RawText="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ResolvedText="{Binding ResolvedText}" HasResolvedValue="{Binding CanShowResolved}" Suggestions="{Binding DataContext.CompletionProperties, RelativeSource={RelativeSource AncestorType=UserControl}}" ValidateSuggestions="{Binding DataContext.ValidateCompletion, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding IsTextEnabled}" Visibility="{Binding ShowText, Converter={StaticResource Visibility}}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                         IsUndoEnabled="False" LostKeyboardFocus="OnFieldLostFocus" AutomationProperties.Name="Procedure entry text" />
                                <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap" Opacity="0.75" />
                                <TextBlock Text="{Binding ExclusionText}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Expander Header="Effective sequence" Visibility="{Binding HasAnalysis, Converter={StaticResource Visibility}}" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding EffectiveItems}" ItemTemplate="{StaticResource ProcedureAnalysisRow}" Margin="0,6,0,0" />
                      </Expander>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
          </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
