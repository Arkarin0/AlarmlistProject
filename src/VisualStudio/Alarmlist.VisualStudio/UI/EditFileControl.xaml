<UserControl x:Class="Alarmlist.VisualStudio.EditFileControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:Alarmlist.VisualStudio.UI"
  xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
  Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
  Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
  SizeChanged="OnSizeChanged" PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown" Loaded="OnLoaded" Unloaded="OnUnloaded">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProcedurePreviewResources.xaml" /></ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="Visibility" />
    <Style x:Key="ScopeArrow" TargetType="TextBlock">
      <Setter Property="Text" Value="▸" /><Setter Property="Margin" Value="0,0,8,0" />
      <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Text" Value="▾" /></DataTrigger></Style.Triggers>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxTextBrushKey}}" />
      <Setter Property="Padding" Value="5,3" />
    </Style>
    <Style TargetType="ui:ExpressionTextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
    <Style TargetType="ui:ReferenceComboBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ui:ReferenceComboBox">
        <Border x:Name="ReferenceBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            <Button x:Name="PART_ReferenceToggle" Grid.Column="1" Content="▾" Focusable="False" IsTabStop="False" Padding="0" Margin="0" Tag="PreserveDraft"
                    ToolTip="Show matching references (F4 or Alt+Down). Type an identifier or alarm name to filter."
                    AutomationProperties.Name="Show reference choices" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ReferenceBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
      <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="CheckBorder" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <Path x:Name="CheckMark" Data="M 2,7 L 6,11 L 12,3" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Visibility="Collapsed" />
          </Border>
          <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /><Setter TargetName="CheckBorder" Property="BorderThickness" Value="2" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="9,3" /><Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
      <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
      <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="InlineInheritedProcedure">
      <AdornerDecorator Visibility="{Binding IsVisible, Converter={StaticResource Visibility}}" Margin="0,0,0,5">
        <ContentControl ui:InheritedValueBehavior.IsInherited="{Binding IsInherited}" Focusable="False"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        ToolTip="{Binding HelpText}" AutomationProperties.HelpText="{Binding HelpText}">
          <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}" Padding="26,5,5,5">
            <Border.Style><Style TargetType="Border"><Style.Triggers>
              <DataTrigger Binding="{Binding IsExcluded}" Value="True"><Setter Property="Opacity" Value="0.78" /></DataTrigger>
            </Style.Triggers></Style></Border.Style>
            <StackPanel>
              <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="↗ Source" Command="{Binding GoToSourceCommand}"
                        ToolTip="{Binding OriginText}" AutomationProperties.Name="{Binding Kind, StringFormat=Go to source for inherited {0}}" />
                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding State}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                       VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Kind, StringFormat=Inherited procedure {0}}"
                       AutomationProperties.HelpText="{Binding HelpText}" />
            </StackPanel>
          </Border>
        </ContentControl>
      </AdornerDecorator>
    </DataTemplate>
  </ResourceDictionary></UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="FileAreaRow" Height="1*" /><RowDefinition Height="Auto" /><RowDefinition x:Name="AlarmAreaRow" Height="3*" /></Grid.RowDefinitions>
    <ToggleButton x:Name="FileAreaHeader" IsChecked="{Binding DesignerLayout.FileExpanded}" Tag="PreserveDraft" HorizontalContentAlignment="Left" Padding="8,5" Margin="0,0,0,6"
                  AutomationProperties.Name="File settings" ToolTip="Show or hide file settings. File parameters apply to every alarm in this file. Layout changes keep drafts private.">
      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ScopeArrow}" /><TextBlock Text="File settings" FontWeight="SemiBold" /></StackPanel>
    </ToggleButton>
    <ScrollViewer x:Name="FileAreaScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="File settings content">
    <StackPanel Margin="0,0,8,8">
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Label Content="Project context" Target="{Binding ElementName=ProjectContextSelector}" Padding="0,3,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      <TextBlock Grid.Column="1" Text="{Binding ProjectContextLabel}" ToolTip="{Binding SelectedProjectPath}" TextWrapping="Wrap" VerticalAlignment="Center"
                 Visibility="{Binding HasSingleProjectContext, Converter={StaticResource Visibility}}" AutomationProperties.Name="Current project context" />
      <ComboBox x:Name="ProjectContextSelector" Grid.Column="1" ItemsSource="{Binding Projects}" SelectedValuePath="ProjectPath" SelectedValue="{Binding SelectedProjectPath}"
                Visibility="{Binding HasMultipleProjects, Converter={StaticResource Visibility}}" ToolTip="Choose which project supplies analysis for this linked file."
                AutomationProperties.Name="Analysis project context">
        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem">
          <Setter Property="AutomationProperties.Name"><Setter.Value>
            <MultiBinding StringFormat="{}{0} ({1})"><Binding Path="ProjectPath" /><Binding Path="Configuration" /></MultiBinding>
          </Setter.Value></Setter>
        </Style></ComboBox.ItemContainerStyle>
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding ProjectPath}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      </Grid>
      <ui:ParameterListControl DataContext="{Binding FileParameters}" LostKeyboardFocus="OnFieldLostFocus" Margin="0,0,0,8" />
      <ui:LiveStatusTextBlock Text="{Binding CultureGuidance}" TextWrapping="Wrap" />
      <ui:LiveStatusTextBlock Text="{Binding AnalysisMessage}" TextWrapping="Wrap" />
      <ui:LiveStatusTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
      <Expander Header="{Binding DiagnosticsHeading}" Margin="0,4,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
          <StackPanel>
            <TextBlock Text="{Binding DiagnosticsGuidance}" TextWrapping="Wrap" Margin="0,4,0,6" />
            <ItemsControl ItemsSource="{Binding Diagnostics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Locations}">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Command="{Binding NavigateCommand}" HorizontalAlignment="Left" Margin="0,3,0,0" AutomationProperties.Name="{Binding Label}">
                          <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        </Button>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Expander>
    </StackPanel>
    </ScrollViewer>
    <GridSplitter x:Name="ScopeDivider" Grid.Row="2" Height="7" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                  Tag="PreserveDraft" Focusable="True" KeyboardIncrement="12" DragCompleted="OnScopeDragCompleted" KeyUp="OnScopeDividerKeyUp"
                  AutomationProperties.Name="Resize file and alarm areas" ToolTip="Drag to resize file and alarm areas, or focus this divider and use Up/Down. Drafts are preserved.">
      <GridSplitter.Style><Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /></Trigger></Style.Triggers>
      </Style></GridSplitter.Style>
    </GridSplitter>
    <Grid Grid.Row="3">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <ToggleButton x:Name="AlarmAreaHeader" IsChecked="{Binding DesignerLayout.AlarmExpanded}" Tag="PreserveDraft" HorizontalContentAlignment="Left" Padding="8,5" Margin="0,6,0,6"
                  AutomationProperties.Name="Alarm settings" ToolTip="Show or hide alarm editing. Fields and procedures apply to the selected alarm. Layout changes keep drafts private.">
      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ScopeArrow}" /><TextBlock Text="Alarm settings" FontWeight="SemiBold" /><TextBlock Text="{Binding Selected.Title, StringFormat=  — {0}}" TextTrimming="CharacterEllipsis" /></StackPanel>
    </ToggleButton>
    <Grid x:Name="AlarmAreaContent" Grid.Row="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="_Add alarm" Command="{Binding AddCommand}" />
        <Button Content="_Delete" Command="{Binding DeleteCommand}" />
      </StackPanel>
      <TextBlock Text="Filter alarms" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter alarms" ToolTip="Filter alarms by name or identifier" Margin="0,0,10,0" />
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ListBox x:Name="AlarmList" ItemsSource="{Binding Alarms}" SelectedItem="{Binding Selected}" Background="Transparent" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,12,0" AutomationProperties.Name="Alarms">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Title}" /></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Identity}" FontSize="11" Opacity="0.75" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <DockPanel Grid.Column="1">
        <ComboBox x:Name="AlarmSelector" DockPanel.Dock="Top" ItemsSource="{Binding Alarms}" SelectedItem="{Binding Selected}" DisplayMemberPath="Title" Visibility="Collapsed" Margin="0,0,0,8" AutomationProperties.Name="Selected alarm">
          <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Title}" /></Style></ComboBox.ItemContainerStyle>
        </ComboBox>
        <ScrollViewer x:Name="AlarmAreaScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Alarm settings content">
          <StackPanel>

          <ui:ParameterListControl DataContext="{Binding AlarmParameters}" LostKeyboardFocus="OnFieldLostFocus" Margin="0,0,8,12" />
          <StackPanel IsEnabled="{Binding CanEdit}">
          <CheckBox Content="Abstract template" IsChecked="{Binding IsAbstract}" Margin="0,0,8,12" AutomationProperties.Name="Abstract template"
                    ToolTip="A template can supply inherited values but is excluded from compiled alarm output." />
          <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding CanEdit}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,8,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Label x:Name="FieldLabel" Content="{Binding Name}" Padding="0,5,6,0"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Label.Style><Style TargetType="Label"><Setter Property="Target" Value="{Binding ElementName=LocalValueEditor}" /><Style.Triggers>
                      <DataTrigger Binding="{Binding IsReference}" Value="True"><Setter Property="Target" Value="{Binding ElementName=ReferenceValueEditor}" /></DataTrigger>
                    </Style.Triggers></Style></Label.Style>
                  </Label>
                  <AdornerDecorator Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ContentControl Width="26" Height="27" Focusable="False" IsHitTestVisible="False"
                                    ui:InheritedValueBehavior.IsInherited="{Binding IsInherited}"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </AdornerDecorator>
                  <ui:ExpressionTextBox x:Name="LocalValueEditor" Grid.Column="2" RawText="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" ResolvedText="{Binding ResolvedValue}" HasResolvedValue="{Binding CanShowResolved}" IsExpressionEnabled="{Binding IsScalar}" Suggestions="{Binding DataContext.CompletionProperties, RelativeSource={RelativeSource AncestorType=UserControl}}" ArgumentBindings="{Binding DataContext.CompletionBindings, RelativeSource={RelativeSource AncestorType=UserControl}}" ValidateSuggestions="{Binding DataContext.ValidateCompletion, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding Name}" AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" AutomationProperties.HelpText="{Binding EditHelp}" ToolTip="{Binding EditHelp}" LostKeyboardFocus="OnFieldLostFocus" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="27" MaxHeight="110" VerticalScrollBarVisibility="Auto" IsUndoEnabled="False"
                                        ContextMenuOpening="OnActionsMenuOpening" Unloaded="OnActionsUnloaded">
                    <ui:ExpressionTextBox.Style><Style TargetType="ui:ExpressionTextBox" BasedOn="{StaticResource {x:Type ui:ExpressionTextBox}}"><Style.Triggers>
                      <DataTrigger Binding="{Binding IsReference}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></ui:ExpressionTextBox.Style>
                    <ui:ExpressionTextBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Cut" Command="ApplicationCommands.Cut" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Paste" Command="ApplicationCommands.Paste" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Use inherited value" Command="{Binding UseInheritedCommand}" Visibility="{Binding IsScalar, Converter={StaticResource Visibility}}"
                                  ToolTip="Remove this local field. The reference supplies its value again; Undo restores the local value."
                                  AutomationProperties.Name="{Binding Name, StringFormat=Use inherited {0}}" />
                        <MenuItem Header="Go to source" Command="{Binding GoToSourceCommand}" Visibility="{Binding IsScalar, Converter={StaticResource Visibility}}"
                                  ToolTip="Open the source that supplies this inherited value." AutomationProperties.Name="{Binding Name, StringFormat=Go to source for {0}}" />
                      </ContextMenu>
                    </ui:ExpressionTextBox.ContextMenu>
                  </ui:ExpressionTextBox>
                  <DockPanel Grid.Column="2" Visibility="{Binding IsReference, Converter={StaticResource Visibility}}">
                    <Button DockPanel.Dock="Right" Content="↗" Margin="4,0,0,0" Command="{Binding DataContext.GoToReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip="Open the referenced alarm's source." AutomationProperties.Name="Go to reference" />
                    <ui:ReferenceComboBox x:Name="ReferenceValueEditor" Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Choices="{Binding DataContext.ReferenceChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ApplyChoice="{Binding DataContext.AcceptReference, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          AutomationProperties.Name="ReferenceName" AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" MinHeight="27" IsUndoEnabled="False" LostKeyboardFocus="OnFieldLostFocus"
                                          ToolTip="Type an identifier or alarm name to search. Arrows choose and Enter applies. Escape closes suggestions first; Enter then commits a literal value. Clear the text to remove the reference."
                                          AutomationProperties.HelpText="Search by identifier or alarm name. F4 opens choices; arrows choose; Enter applies; Escape closes. Literal references remain editable." />
                  </DockPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander Header="Test procedure" IsExpanded="True" Margin="0,6,8,0"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Margin="0,8,0,0">
              <ItemsControl ItemsSource="{Binding ProcedureSections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,16">
                      <DockPanel Margin="0,0,0,6">
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding ShowCleared}" IsEnabled="{Binding HasExcluded}"
                                      Tag="PreserveDraft" ToolTip="{Binding ClearedHelp}" ToolTipService.ShowOnDisabled="True"
                                      AutomationProperties.Name="{Binding Name, StringFormat=Show cleared {0} entries}"
                                      AutomationProperties.HelpText="{Binding ClearedHelp}" Padding="6,3">
                          <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="1.5"
                                  Data="M 1,8 Q 8,-2 15,8 Q 8,18 1,8 M 11,8 A 3,3 0 1 1 5,8 A 3,3 0 1 1 11,8" />
                            <TextBlock Text="{Binding ClearedToggleText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                          </StackPanel>
                        </ToggleButton>
                        <Button DockPanel.Dock="Right" Content="Inheritance ▾" Click="OnInheritanceActions" Tag="PreserveDraft"
                                Unloaded="OnActionsUnloaded" ContextMenuOpening="OnActionsMenuOpening"
                                ToolTip="Actions for this entire procedure group. Inherited entries remain read-only."
                                AutomationProperties.Name="{Binding Name, StringFormat=Inheritance actions for {0}}">
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Use local entries only" Command="{Binding UseLocalEntriesCommand}"
                                        ToolTip="Insert Clear before local entries to exclude inherited entries. Undo restores the previous source." />
                              <MenuItem Header="Make local copy" Command="{Binding MakeLocalCopyCommand}" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Copy the effective sequence, preserving raw expressions. Future reference changes stop flowing into this group. Commit or cancel drafts first." />
                            </ContextMenu>
                          </Button.ContextMenu>
                        </Button>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </DockPanel>
                      <ui:LiveStatusTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding AnalysisGuidance}" TextWrapping="Wrap" Margin="0,0,0,5">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                          <DataTrigger Binding="{Binding HasAnalysis}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding InheritedSequence}" ItemTemplate="{StaticResource InlineInheritedProcedure}" />
                      <WrapPanel Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewKind}" MinWidth="92" Margin="0,0,6,0"
                                  AutomationProperties.Name="{Binding Name, StringFormat=New {0} entry kind}" />
                        <Button Content="+ Add entry" Command="{Binding AddCommand}" Click="OnProcedureAction" ToolTip="Append an entry to this group and start editing it."
                                AutomationProperties.Name="{Binding Name, StringFormat=Add {0} entry}" />
                      </WrapPanel>
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}"
                                    Padding="6" Margin="0,0,0,5"
                                    ToolTip="{Binding HelpText}">
                              <Border.Style><Style TargetType="Border">
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Visibility}}" />
                                <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExcluded}" Value="True"><Setter Property="Opacity" Value="0.78" /></DataTrigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="Visibility" Value="Visible" /></Trigger>
                              </Style.Triggers></Style></Border.Style>
                              <StackPanel>
                                <WrapPanel Margin="0,0,0,5">
                                  <TextBlock Text="{Binding State}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                  <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding CanEdit}" MinWidth="88" Margin="0,0,6,0"
                                            AutomationProperties.Name="Procedure entry kind" LostKeyboardFocus="OnFieldLostFocus" />
                                  <Button Content="↑" Command="{Binding MoveUpCommand}" Click="OnProcedureAction" ToolTip="Move entry up. Moving across Clear changes which entries are included." AutomationProperties.Name="Move procedure entry up" />
                                  <Button Content="↓" Command="{Binding MoveDownCommand}" Click="OnProcedureAction" ToolTip="Move entry down. Moving across Clear changes which entries are included." AutomationProperties.Name="Move procedure entry down" />
                                  <Button Content="×" Command="{Binding DeleteCommand}" Click="OnProcedureAction" ToolTip="Remove this local source entry. Undo restores it." AutomationProperties.Name="Remove procedure entry" />
                                </WrapPanel>
                                <Separator Visibility="{Binding IsClear, Converter={StaticResource Visibility}}" />
                                <TextBlock Text="Clear preceding entries" FontWeight="SemiBold" Visibility="{Binding IsClear, Converter={StaticResource Visibility}}" />
