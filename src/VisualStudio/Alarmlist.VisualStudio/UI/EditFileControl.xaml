                          <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,6,0" /><ui:ExplainValueButton ActionName="{Binding Label, StringFormat=Explain this value for cleared {0}}" />
                          </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </Expander>
                    </Border>
