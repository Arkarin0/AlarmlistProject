<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <BooleanToVisibilityConverter x:Key="CollectionVisibility" />
  <DataTemplate x:Key="DefaultCollectionRecord">
    <ItemsControl ItemsSource="{Binding OrderedFields}">
      <ItemsControl.ItemTemplate><DataTemplate>
        <TextBlock TextWrapping="Wrap"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding DisplayText, Mode=OneWay}" /></TextBlock>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>
  <DataTemplate x:Key="CollectionPreviewCell">
    <StackPanel Margin="6,4">
      <TextBlock x:Name="SimpleText" Text="{Binding DisplayText}" TextWrapping="Wrap" />
      <StackPanel x:Name="Records" Visibility="Collapsed">
        <TextBlock Text="{Binding StateText}" />
        <ItemsControl ItemsSource="{Binding VisibleItems}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel Margin="0,0,0,8">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DefaultCollectionRecord}" Focusable="False" />
              <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Button Content="{Binding ExpansionLabel}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"
              Visibility="{Binding CanExpand, Converter={StaticResource CollectionVisibility}}" />
    </StackPanel>
    <DataTemplate.Triggers><DataTrigger Binding="{Binding IsComplex}" Value="True">
      <Setter TargetName="SimpleText" Property="Visibility" Value="Collapsed" />
      <Setter TargetName="Records" Property="Visibility" Value="Visible" />
    </DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
