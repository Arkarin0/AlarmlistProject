<UserControl x:Class="Alarmlist.VisualStudio.UI.ExplanationControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:Alarmlist.VisualStudio.UI"
 xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
 Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}">
 <Expander Header="Explanation" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" AutomationProperties.Name="Explanation"
           Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" Margin="0,6,0,0">
  <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="6">
    <ui:LiveStatusTextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.Name="Explanation status" />
    <TextBlock Text="{Binding Context}" TextWrapping="Wrap" Margin="0,4" AutomationProperties.Name="Explanation context" />
    <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Explained value" />
    <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" Margin="0,4" AutomationProperties.Name="Explanation diagnostics" />
    <TextBlock Text="{Binding PageLabel}" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate>
     <Expander Header="{Binding Label}" Margin="0,3" AutomationProperties.Name="{Binding Label}"
               Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}">
      <StackPanel Margin="8,3">
       <TextBox Text="{Binding Values, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Step values" />
       <TextBlock Text="{Binding Origin}" TextWrapping="Wrap" /><TextBlock Text="{Binding Dependencies}" TextWrapping="Wrap" />
       <Button Content="Go to source" Command="{Binding GoToSourceCommand}" HorizontalAlignment="Left" Margin="0,3" AutomationProperties.Name="{Binding Label, StringFormat=Go to source for {0}}" />
      </StackPanel>
     </Expander>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="Show more steps" Command="{Binding ShowMoreCommand}" HorizontalAlignment="Left" Margin="0,4" AutomationProperties.Name="Show more explanation steps" />
   </StackPanel>
  </ScrollViewer>
 </Expander>
</UserControl>
