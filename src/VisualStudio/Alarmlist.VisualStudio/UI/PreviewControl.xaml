<UserControl x:Class="Alarmlist.VisualStudio.UI.PreviewControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:Alarmlist.VisualStudio.UI"
 xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
 Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
 Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
 AutomationProperties.Name="Alarmlist Preview" PreviewKeyDown="OnPreviewKeyDown">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProcedurePreviewResources.xaml" /><ResourceDictionary Source="EditorHelpResources.xaml" /><ResourceDictionary Source="CollectionPreviewResources.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
   <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxTextBrushKey}}" />
   <Setter Property="Padding" Value="5,3" />
  </Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="9,3" /></Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="16" Height="16" BorderThickness="1" Margin="0,0,7,0" BorderBrush="{TemplateBinding Foreground}">
     <Path x:Name="Mark" Data="M 2,7 L 6,11 L 12,3" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Visibility="Collapsed" />
    </Border><ContentPresenter VerticalAlignment="Center" /></StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /><Setter TargetName="Box" Property="BorderThickness" Value="2" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ReportCellText" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="VerticalAlignment" Value="Top" />
   <Setter Property="Margin" Value="6,4" />
  </Style>
  <Style x:Key="TableAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="IsEnabled" Value="{Binding CanUseProjectPreview}" />
   <Style.Triggers><DataTrigger Binding="{Binding SelectedPreviewRow}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="ToolTip" Value="Click to sort. Drag a header to reorder or its edge to resize. Columns also provides keyboard controls. Test method shows effective instructions and reset steps." />
   <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
   <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
   <Setter Property="Padding" Value="7,5" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
    <Grid Background="{TemplateBinding Background}">
     <Border Padding="{TemplateBinding Padding}" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}">
      <DockPanel><TextBlock x:Name="SortArrow" DockPanel.Dock="Right" Margin="6,0,0,0" /><ContentPresenter RecognizesAccessKey="True" /></DockPanel>
     </Border>
     <Thumb x:Name="PART_LeftHeaderGripper" Width="5" HorizontalAlignment="Left" Opacity="0" Cursor="SizeWE" />
     <Thumb x:Name="PART_RightHeaderGripper" Width="5" HorizontalAlignment="Right" Opacity="0" Cursor="SizeWE" />
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortArrow" Property="Text" Value="↑" /></Trigger>
     <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortArrow" Property="Text" Value="↓" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
   <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
   <Setter Property="Padding" Value="10,5" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
            BorderThickness="1" BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}">
     <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True">
      <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
      <Setter Property="FontWeight" Value="SemiBold" />
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="8">
  <TextBlock Text="Open an ALMX document or choose a project in Preview scope." TextWrapping="Wrap">
   <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
   </Style></TextBlock.Style>
  </TextBlock>
  <DockPanel>
   <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers>
    <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
   </Style.Triggers></Style></DockPanel.Style>
   <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedPreviewCulture, StringFormat=Preview language: {0}}" Margin="12,0,0,0" />
     <TextBlock Text="{Binding PreviewContext}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreviewContext}" />
    </DockPanel>
    <TextBlock Text="{Binding BufferGuidance}" TextWrapping="Wrap" Margin="0,3,0,0" />
    <ui:LiveStatusTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
   </StackPanel>
   <TabControl x:Name="PreviewTabs" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="Preview views" SelectedIndex="1">
    <TabItem Header="Alarm table" AutomationProperties.Name="Alarm table preview">
     <DockPanel Margin="8">
      <StackPanel DockPanel.Dock="Top">
       <ui:LiveStatusTextBlock Text="{Binding PreviewColumns.Error}" TextWrapping="Wrap">
        <ui:LiveStatusTextBlock.Style><Style TargetType="ui:LiveStatusTextBlock"><Style.Triggers>
         <DataTrigger Binding="{Binding PreviewColumns.Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers></Style></ui:LiveStatusTextBlock.Style>
       </ui:LiveStatusTextBlock>
       <Expander x:Name="ColumnsChooser" Header="Columns" AutomationProperties.Name="Preview columns" Margin="0,0,0,6"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 ToolTip="Show, hide, reorder or resize preview columns. These preferences belong to this project and user.">
        <StackPanel Margin="6">
         <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Reset layout" Command="{Binding PreviewColumns.ResetCommand}" AutomationProperties.Name="Reset preview column layout" ToolTip="Restore the default column visibility, order and widths." />
          <ui:LiveStatusTextBlock Text="{Binding PreviewColumns.Status}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
         <ScrollViewer MaxHeight="235" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding PreviewColumns.Columns}"><ItemsControl.ItemTemplate><DataTemplate>
           <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="64" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Position}" VerticalAlignment="Center" ToolTip="Column position, including hidden columns." />
            <CheckBox Grid.Column="1" Content="{Binding Label}" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label, StringFormat=Show {0} column}" ToolTip="Show or hide this column. Hidden columns are excluded from copied rows." />
            <TextBlock Grid.Column="2" Text="Width" Margin="8,0,5,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Label, StringFormat=Width of {0} column}" ToolTip="Column width in device-independent pixels, from 40 to 2000." />
            <Button Grid.Column="4" Content="←" Margin="6,0,0,0" Command="{Binding MoveLeftCommand}" AutomationProperties.Name="{Binding Label, StringFormat=Move {0} column left}" ToolTip="Move this column one position left, including hidden columns." />
            <Button Grid.Column="5" Content="→" Margin="3,0,0,0" Command="{Binding MoveRightCommand}" AutomationProperties.Name="{Binding Label, StringFormat=Move {0} column right}" ToolTip="Move this column one position right, including hidden columns." />
           </Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         </ScrollViewer>
        </StackPanel>
       </Expander>
       <Grid Margin="0,0,0,6" SizeChanged="OnPreviewToolbarSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <DockPanel>
         <TextBlock Text="Filter alarms" VerticalAlignment="Center" Margin="0,0,8,0" />
         <TextBox Text="{Binding AlarmTableFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter preview alarms" ToolTip="Filter resolved values, identities and source paths" />
        </DockPanel>
        <WrapPanel x:Name="PreviewTableActions" Grid.Column="1" Margin="8,0,0,0">
         <TextBlock Text="{Binding AlarmTableCount}" VerticalAlignment="Center" Margin="0,0,8,0" />
         <Button Content="Go to source" Click="OnGoToSource" Margin="0,0,6,0" Style="{StaticResource TableAction}" AutomationProperties.Name="Go to selected alarm source"
                 ToolTip="Select a row from the current preview, then go to its source. Enter in the table also goes to source." ToolTipService.ShowOnDisabled="True" />
         <Button Content="Copy selected rows" Click="OnCopyRows" Style="{StaticResource TableAction}" AutomationProperties.Name="Copy selected preview rows"
                 ToolTip="Select rows from the current preview to copy the visible columns in display order. Ctrl+C in the table also copies them." ToolTipService.ShowOnDisabled="True" />
        </WrapPanel>
       </Grid>
       <ui:LiveStatusTextBlock Text="{Binding AlarmTableMessage}" TextWrapping="Wrap">
        <ui:LiveStatusTextBlock.Style><Style TargetType="ui:LiveStatusTextBlock"><Style.Triggers>
         <DataTrigger Binding="{Binding AlarmTableMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers></Style></ui:LiveStatusTextBlock.Style>
       </ui:LiveStatusTextBlock>
      </StackPanel>
      <DataGrid x:Name="AlarmTable" ItemsSource="{Binding AlarmTableRows, NotifyOnTargetUpdated=True}" SelectedItem="{Binding SelectedPreviewRow}" TargetUpdated="OnTableRowsUpdated"
                AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" ColumnReordered="OnColumnReordered"
                SelectionMode="Extended" SelectionUnit="FullRow" ClipboardCopyMode="None" HeadersVisibility="Column" GridLinesVisibility="All"
                EnableRowVirtualization="True" EnableColumnVirtualization="False" MinRowHeight="28"
                ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}"
                HorizontalGridLinesBrush="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}"
                VerticalGridLinesBrush="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBorderBrushKey}}"
                Sorting="OnTableSorting" MouseDoubleClick="OnTableDoubleClick" SelectionChanged="OnTableSelectionChanged" AutomationProperties.Name="Resolved alarm table"
                AutomationProperties.HelpText="Read-only resolved values with wrapped procedures. Select a row to inspect it. Double-click or press Enter to go to source. Ctrl+C copies selected rows.">
       <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Columns…" Click="OnOpenColumns" ToolTip="Open the column chooser and keyboard layout controls." /></ContextMenu></DataGrid.ContextMenu>
       <DataGrid.RowStyle><Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Status}" />
        <Setter Property="ToolTip" Value="{Binding SourcePath}" />
        <Style.Triggers><Trigger Property="IsSelected" Value="True">
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
         <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
        </Trigger></Style.Triggers>
       </Style></DataGrid.RowStyle>
       <DataGrid.CellStyle><Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="BorderThickness" Value="0" />
       </Style></DataGrid.CellStyle>

      </DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Header="Selected alarm" AutomationProperties.Name="Selected alarm preview">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">

            <StackPanel Margin="0,6,0,0">

              <ui:LiveStatusTextBlock Text="{Binding ResolvedPreviewMessage}" TextWrapping="Wrap" Margin="0,4,0,8" />
              <ItemsControl ItemsSource="{Binding ResolvedFields}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <AdornerDecorator>
                      <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" Padding="26,3,5,3"
                               ui:InheritedValueBehavior.IsInherited="{Binding IsInherited}" TextWrapping="Wrap"
                               MaxHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Name, StringFormat=Resolved {0}}"
                               AutomationProperties.HelpText="{Binding OriginText}" ToolTip="{Binding OriginText}" />
                    </AdornerDecorator>
                    <TextBlock Text="{Binding OriginText}" TextWrapping="Wrap" />
                    <Button Content="Go to source" Command="{Binding GoToSourceCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            AutomationProperties.Name="{Binding Name, StringFormat=Go to source for resolved {0}}" />
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding ResolvedSections}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Margin="0,3,0,6" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ProcedureAnalysisRow}" />
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding ResolvedCollections}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Expander Header="{Binding Label}" IsExpanded="True" Margin="0,0,0,10">
                    <StackPanel><TextBlock Text="{Binding Summary}" />
                      <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
                        <GroupBox Header="{Binding Label}" Margin="0,4">
                          <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="{Binding Name, StringFormat=Resolved collection {0}}" />
                              <TextBlock Text="{Binding OriginText}" TextWrapping="Wrap" />
                              <Button Content="Go to source" Command="{Binding GoToSourceCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </GroupBox>
                      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                  </Expander>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

     </ScrollViewer>
    </TabItem>
    <TabItem Header="Compiled XML" AutomationProperties.Name="Compiled XML preview">
     <DockPanel Margin="8">
      <ui:LiveStatusTextBlock DockPanel.Dock="Top" Text="{Binding XmlPreviewMessage}" TextWrapping="Wrap" Margin="0,0,0,6" />
      <TextBox Text="{Binding CompiledXml, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               AutomationProperties.Name="Compiled project XML" AutomationProperties.HelpText="{Binding XmlPreviewMessage}" />
     </DockPanel>
    </TabItem>
   </TabControl>
  </DockPanel>
 </Grid>
</UserControl>
