<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <_AlarmlistTaskFramework Condition="'$(MSBuildRuntimeType)' == 'Core'">net8.0</_AlarmlistTaskFramework>
    <_AlarmlistTaskFramework Condition="'$(MSBuildRuntimeType)' != 'Core'">net472</_AlarmlistTaskFramework>
    <AlarmlistMSBuildAssembly Condition="'$(AlarmlistMSBuildAssembly)' == ''">$(MSBuildThisFileDirectory)..\..\..\artifacts\bin\AlarmList.MSBuild\$(Configuration)\$(_AlarmlistTaskFramework)\AlarmList.MSBuild.dll</AlarmlistMSBuildAssembly>
    <OutputPath Condition="'$(OutputPath)' == ''">$(MSBuildProjectDirectory)\bin\</OutputPath>
    <CompiledAlarmlistFileName Condition="'$(CompiledAlarmlistFileName)' == ''">SampleData.Alarmlist.xml</CompiledAlarmlistFileName>
    <IncludeConditionalAlarms Condition="'$(IncludeConditionalAlarms)' == ''">false</IncludeConditionalAlarms>
    <IncludeMissingReferenceAlarm Condition="'$(IncludeMissingReferenceAlarm)' == ''">false</IncludeMissingReferenceAlarm>
  </PropertyGroup>

  <UsingTask TaskName="Alarmlist.MSBuild.AlarmlistBuildTask"
             AssemblyFile="$(AlarmlistMSBuildAssembly)" />

  <ItemGroup>    
    <Compile Include="$(MSBuildProjectDirectory)\PartA.almx" />
    <Compile Include="$(MSBuildProjectDirectory)\PartB.almx" />
    <Compile Include="$(MSBuildProjectDirectory)\Conditional.almx" Condition="'$(IncludeConditionalAlarms)' == 'true'" />
    <Compile Include="$(MSBuildProjectDirectory)\MissingReference.almx" Condition="'$(IncludeMissingReferenceAlarm)' == 'true'" />
  </ItemGroup>

  <Target Name="Build">
    <AlarmlistBuildTask OutputDirectory="$(OutputPath)"
                        OutputFileName="$(CompiledAlarmlistFileName)"
                        Compile="@(Compile)">
      <Output TaskParameter="OutputFile" PropertyName="CompiledAlarmlistFile" />
    </AlarmlistBuildTask>
  </Target>
</Project>
