<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(MSBuildRuntimeType)' == 'Core'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(MSBuildRuntimeType)' != 'Core'">net472</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <AssemblyName>LifecycleRules</AssemblyName>
    <OutputPath>rules/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LifecycleRules.cs" />
    <Reference Include="Alarmlist.Core" HintPath="$(CompilerPath)" Private="false" />
  </ItemGroup>
</Project>
