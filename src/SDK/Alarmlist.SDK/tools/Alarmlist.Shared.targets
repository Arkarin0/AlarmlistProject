<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Imported by the native Shared Project container only. Do not import the
       compiler build pipeline or give the container a consumer analysis context. -->
  <PropertyGroup>
    <SharedProjectAppliesTo>Alarmlist</SharedProjectAppliesTo>
    <AddItemTemplatesGuid>{117e1e3b-8dc0-44bf-a627-4e41f84721d8}</AddItemTemplatesGuid>
  </PropertyGroup>
  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/ProjectItemsSchema.xaml" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/GeneralFile.xaml" Context="File" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/Compile.xaml" Context="File;BrowseObject" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/AlarmlistResource.xaml" Context="File;BrowseObject" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/AlarmlistLookup.xaml" Context="File;BrowseObject" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/None.xaml" Context="File;BrowseObject" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/Folder.xaml" Context="File;BrowseObject" />
  </ItemGroup>
</Project>
