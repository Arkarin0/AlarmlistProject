<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:l="urn:alarmlist:lookup:1" targetNamespace="urn:alarmlist:lookup:1"
           elementFormDefault="qualified">
  <xs:annotation><xs:documentation>
    Alarmlist lookup catalogue version 1. Keys are case-sensitive technical identities.
    LabelKey references a RESX entry. Metadata is literal text with no compiler-defined semantics.
    List Entry Value is literal. Description and DescriptionKey are mutually exclusive
    (also enforced by the compiler). Template Argument List is a completion hint.
  </xs:documentation></xs:annotation>
  <xs:simpleType name="Key">
    <xs:restriction base="xs:string">
      <xs:pattern value="[\p{L}_][\p{L}\p{M}\p{N}_.\-]*" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ResourceKey">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_.\-]*" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="Member">
    <xs:sequence>
      <xs:element name="Metadata" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="Name" type="l:Key" use="required" />
          <xs:attribute name="Value" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="Key" type="l:Key" use="required" />
    <xs:attribute name="LabelKey" type="l:ResourceKey" use="required" />
  </xs:complexType>
  <xs:simpleType name="ArgumentName">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_]*" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="Lookup">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Path">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Segment" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="LabelKey" type="l:ResourceKey" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="Property" type="l:Member">
                  <xs:unique name="PropertyMetadataNames">
                    <xs:selector xpath="l:Metadata" /><xs:field xpath="@Name" />
                  </xs:unique>
                </xs:element>
                <xs:element name="Button" type="l:Member">
                  <xs:unique name="ButtonMetadataNames">
                    <xs:selector xpath="l:Metadata" /><xs:field xpath="@Name" />
                  </xs:unique>
                </xs:element>
              </xs:choice>
            </xs:sequence>
            <xs:attribute name="Key" type="l:Key" use="required" />
          </xs:complexType>
          <xs:unique name="MemberKeys">
            <xs:selector xpath="l:Property | l:Button" /><xs:field xpath="@Key" />
          </xs:unique>
        </xs:element>
        <xs:element name="List">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Entry" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Metadata" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="Name" type="l:Key" use="required" />
                        <xs:attribute name="Value" type="xs:string" use="required" />
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="Key" type="l:Key" use="required" />
                  <xs:attribute name="Value" type="xs:string" use="required" />
                  <xs:attribute name="Description" type="xs:string" />
                  <xs:attribute name="DescriptionKey" type="l:ResourceKey" />
                </xs:complexType>
                <xs:unique name="EntryMetadataNames">
                  <xs:selector xpath="l:Metadata" /><xs:field xpath="@Name" />
                </xs:unique>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="Key" type="l:Key" use="required" />
          </xs:complexType>
          <xs:unique name="EntryKeys">
            <xs:selector xpath="l:Entry" /><xs:field xpath="@Key" />
          </xs:unique>
        </xs:element>
        <xs:element name="Template">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Argument" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="Name" type="l:ArgumentName" use="required" />
                  <xs:attribute name="List" type="l:Key" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="Key" type="l:ResourceKey" use="required" />
          </xs:complexType>
          <xs:unique name="ArgumentNames">
            <xs:selector xpath="l:Argument" /><xs:field xpath="@Name" />
          </xs:unique>
        </xs:element>
      </xs:choice>
    </xs:complexType>
    <xs:unique name="PathKeys">
      <xs:selector xpath="l:Path" /><xs:field xpath="@Key" />
    </xs:unique>
    <xs:unique name="ListKeys">
      <xs:selector xpath="l:List" /><xs:field xpath="@Key" />
    </xs:unique>
    <xs:unique name="TemplateKeys">
      <xs:selector xpath="l:Template" /><xs:field xpath="@Key" />
    </xs:unique>
  </xs:element>
</xs:schema>
