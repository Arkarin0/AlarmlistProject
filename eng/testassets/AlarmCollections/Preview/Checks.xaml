<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Palette.xaml" /></ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="ChecksPreview">
    <StackPanel>
      <TextBlock Text="Inspection record" Style="{StaticResource RecordHeading}" AutomationProperties.Name="Custom collection record" />
      <TextBlock Text="{Binding Fields[Text].DisplayText}" TextWrapping="Wrap" />
      <TextBlock><Run Text="Count: " /><Run Text="{Binding Fields[Count].DisplayText, Mode=OneWay}" /></TextBlock>
      <TextBlock><Run Text="Copy: " /><Run Text="{Binding Fields[Copy].DisplayText, Mode=OneWay}" /></TextBlock>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
