<Project>
  <Import Project="$(MSBuildThisFileDirectory)Example.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Example.local.props')" />
  <!-- This is an SDK consumer, so do not inherit the repository's Arcade build. -->
  <PropertyGroup>
    <!-- The diagnostics exercise starts with visible warnings and successful builds. -->
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
