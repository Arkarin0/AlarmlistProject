<?xml version="1.0" encoding="utf-8"?>
<Alarmlist>
  <!-- Templates are skipped by the sample rule. The consuming alarm is checked. -->
  <Alarm abstract="true">
    <FullyQualifiedName>Templates.North.LegacyCode</FullyQualifiedName>
    <Code>LEGACY-NORTH</Code>
    <Category>Analyzer playground</Category>
  </Alarm>
  <Alarm>
    <FullyQualifiedName>Plant.North.Diagnostics.Valid</FullyQualifiedName>
    <ReferenceName>Templates.North.LegacyCode</ReferenceName>
    <Name>Valid North code</Name>
    <Code>N-001</Code>
    <Description>North's saved .editorconfig requires the N- prefix.</Description>
  </Alarm>
  <Alarm>
    <FullyQualifiedName>Plant.North.Diagnostics.PrefixWarning</FullyQualifiedName>
    <ReferenceName>Templates.North.LegacyCode</ReferenceName>
    <Name>Inherited code warning</Name>
    <Description>Intentionally inherits LEGACY-NORTH. Set a local Code to N-002 to clear SAMPLE001, then Undo.</Description>
    <TestProcedure>
      <Instructions>
        <Note>Follow SAMPLE001 to this consuming alarm; the template supplies the related code location.</Note>
      </Instructions>
    </TestProcedure>
  </Alarm>
</Alarmlist>
