<?xml version="1.0" encoding="utf-8"?>
<Alarmlist>
  <Properties><Property Name="par1" Value="010" /></Properties>
  <!-- A second reference hop with local Name/Code and inherited Category/Description. -->
  <Alarm>
    <Properties><Property Name="par1" Value="003" /></Properties>
    <FullyQualifiedName>Plant.Pump.PressureLow.Panel</FullyQualifiedName>
    <ReferenceName>Plant.Pump.PressureLow</ReferenceName>
    <Name>$(loc:Panel.Name)</Name>
    <Code>P-002</Code>
    <TestProcedure>
      <Instructions>
        <Hint>$(loc:Panel.Compare)</Hint>
        <Step>$(loc:Panel.Confirm)</Step>
      </Instructions>
    </TestProcedure>
  </Alarm>
  <!-- A standalone alarm for trying scalar and procedure edits. -->
  <Alarm>
    <FullyQualifiedName>Plant.Utility.AirPressureLow</FullyQualifiedName>
    <Name>$(loc:Air.Name)</Name>
    <Code>U-001</Code>
    <Category>$(loc:Air.Category)</Category>
    <Description>$(loc:Air.Description)</Description>
    <TestProcedure>
      <Instructions>
        <Step>$(loc:Air.Compressor)</Step>
        <Step>$(loc:Air.Valve)</Step>
      </Instructions>
      <Reset>
        <Step>$(loc:Air.Reset)</Step>
      </Reset>
    </TestProcedure>
  </Alarm>
  <Alarm>
    <FullyQualifiedName>NewAlarm</FullyQualifiedName>
    <Name>$(loc:NewAlarm.Name)</Name>
    <ReferenceName>Plant.Pump.PressureLow</ReferenceName>
    <Code>P-00A1</Code>
  </Alarm>
</Alarmlist>
