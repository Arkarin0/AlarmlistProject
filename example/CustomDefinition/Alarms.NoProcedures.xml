<?xml version="1.0" encoding="utf-8"?>
<Alarmlist>
  <Properties>
    <Property Name="AlarmNumber" Value="8" />
    <Property Name="PriceValue" Value="12.50" />
  </Properties>
  <Alarm abstract="true">
    <FullyQualifiedName>Templates.Check</FullyQualifiedName>
    <Description>Inherited description</Description>
    <Price>$(PriceValue)</Price>
    <Ratio>0.125</Ratio>
    <Enabled>true</Enabled>
    <Priority>High</Priority>
    <Day>2026-10-23</Day>
    <Clock>14:30:00</Clock>
    <Instant>2026-10-23T14:30:00+02:00</Instant>
    <Tags>
      <Item>equipment</Item>
      <Item>inspection</Item>
    </Tags>
    <Numbers>
      <Item>$(AlarmNumber)</Item>
    </Numbers>
    <Checks>
      <Item>
        <Text>Inherited check</Text>
        <Count>$(AlarmNumber)</Count>
        <Copy>$(item:Count)</Copy>
        <Enabled>true</Enabled>
        <Priority>High</Priority>
      </Item>
    </Checks>
  </Alarm>
  <Alarm>
    <FullyQualifiedName>Plant.Check</FullyQualifiedName>
    <ReferenceName>Templates.Check</ReferenceName>
    <Code>$(AlarmNumber)</Code>
    <Tags>
      <Item>inspection</Item>
    </Tags>
    <Checks>
      <!-- Count is absent: the default supplies 7 and Copy resolves to 7. -->
      <Item>
        <Text>Local check</Text>
        <Copy>$(item:Count)</Copy>
      </Item>
    </Checks>
  </Alarm>
  <!-- Code is absent: the compiler supplies its default without writing it here. -->
  <Alarm>
    <FullyQualifiedName>Plant.Defaults</FullyQualifiedName>
    <Description>Try boolean/enum literal helpers, expressions and numeric bounds.</Description>
    <Enabled>false</Enabled>
    <Priority>Low</Priority>
    <Tags>
      <Item>before clear</Item>
      <Clear />
      <Item>after clear</Item>
    </Tags>
    <Checks>
      <Item />
    </Checks>
  </Alarm>
</Alarmlist>