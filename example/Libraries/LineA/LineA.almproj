<Project Sdk="Alarmlist.MSBuild.SDK">
  <PropertyGroup><AlarmlistCultures>en</AlarmlistCultures><AlarmlistCulture>en</AlarmlistCulture></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Equipment/Equipment.almproj" Condition="'$(UseLibraryPackages)' != 'true'" />
    <PackageReference Include="Example.Equipment" Version="1.0.0" Condition="'$(UseLibraryPackages)' == 'true'" />
    <AlarmlistProperty Include="Site" Value="LineA" />
  </ItemGroup>
</Project>
